integrator               = md
dt                       = 0.001
nsteps                   = 200000     ; 200 ps

cutoff-scheme            = Verlet
nstxout-compressed       = 5000
nstenergy                = 1000
nstlog                   = 1000
nstlist                  = 20
rlist                    = 1.2
coulombtype              = PME
rcoulomb                 = 1.2
vdwtype                  = Cut-off
rvdw                     = 1.2

tcoupl                   = V-rescale
tc-grps                  = System
tau-t                    = 0.5
ref-t                    = 900

pcoupl                   = no

constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

pbc                      = xyz
continuation             = no
gen-vel                  = yes
gen-temp                 = 900
gen-seed                 = -1